# Copiar este archivo como .env.local (que no se sube al repositorio) y ajustar los valores.

# URL de la API para los requests que hace el servidor de Next
# (Server Components y Server Actions, en lib/api). Solo existe en el servidor.
API_URL=http://localhost:8080

# URL de la API para los requests que hace el navegador (página "Mis reservas").
# El prefijo NEXT_PUBLIC_ hace que Next la incluya en el JavaScript que se envía al navegador,
# así que cualquiera puede verla: nunca poner secretos en una variable NEXT_PUBLIC_.
# Como el navegador llama a otro origen (localhost:8080), la API tiene que tener CORS configurado.
NEXT_PUBLIC_API_URL=http://localhost:8080
