# Compila las diapositivas con XeLaTeX y el tema compartido de ../theme.
# El PDF queda junto al .tex; los archivos auxiliares van a build/.
$pdf_mode = 5;
$xelatex = 'xelatex -interaction=nonstopmode -file-line-error %O %S';
$aux_dir = 'build';
$out_dir = '.';
$ENV{'TEXINPUTS'} = '../theme//:' . ($ENV{'TEXINPUTS'} // '');
