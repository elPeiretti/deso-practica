% \utncode[claves]{archivo}  -- bloque de codigo posicionado con fracciones de la
% diapositiva (x, y, w, h) y medidas en puntos (letra, interlineado, margenes).
% Claves: style, x, y, w, h, bg (HTML), fs, lh, padx, pady, num (distancia desde el
% borde izquierdo hasta el borde derecho de los numeros de linea), first.
\pgfkeys{/utncode/.cd,
  style/.store in=\ucStyle, x/.store in=\ucX, y/.store in=\ucY,
  w/.store in=\ucW, h/.store in=\ucH, bg/.store in=\ucBg,
  fs/.store in=\ucFS, lh/.store in=\ucLH,
  padx/.store in=\ucPadX, pady/.store in=\ucPadY,
  num/.store in=\ucNum, first/.store in=\ucFirst}
\newcommand{\utncode}[2][]{%
  \begingroup
  \pgfkeys{/utncode/.cd,first=1,num=0,#1}%
  \definecolor{ucbg}{HTML}{\ucBg}%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[ucbg] ($(current page.north west)+(\ucX\paperwidth,-\ucY\paperheight)$)
      rectangle +(\ucW\paperwidth,-\ucH\paperheight);
    \clip ($(current page.north west)+(\ucX\paperwidth,-\ucY\paperheight)$)
      rectangle +(\ucW\paperwidth,-\ucH\paperheight);
    \node[anchor=north west,inner sep=0] at
      ($(current page.north west)+(\ucX\paperwidth+\ucPadX pt,-\ucY\paperheight-\ucPadY pt)$) {%
      \begin{minipage}{\dimexpr\ucW\paperwidth-\ucPadX pt\relax}
        \ttfamily\fontsize{\ucFS}{\ucLH}\selectfont
        \lstinputlisting[style=\ucStyle,firstnumber=\ucFirst,
          numbersep=\dimexpr\ucPadX pt-\ucNum pt\relax]{resources/code/#2}%
      \end{minipage}};
  \end{tikzpicture}%
  \endgroup}

% \utnrect{color}{grosor}{x}{y}{w}{h}: rectangulo sin relleno (resaltados, marcos)
\newcommand{\utnrect}[6]{%
  \begin{tikzpicture}[remember picture,overlay]
    \draw[#1,line width=#2pt] ($(current page.north west)+(#3\paperwidth,-#4\paperheight)$)
      rectangle +(#5\paperwidth,-#6\paperheight);
  \end{tikzpicture}}


% ===== Lenguajes y estilos de HTML y CSS ==========================================
\definecolor{htTag}{HTML}{800000}
\definecolor{htAttr}{HTML}{E50000}
\definecolor{htStr}{HTML}{0000FF}
\definecolor{htCom}{HTML}{008000}
\definecolor{htJsStr}{HTML}{A31515}
\definecolor{cssNum}{HTML}{098658}
\definecolor{cssVal}{HTML}{0451A5}

% Los atributos se resaltan por nombre; entre ">" y "<" el texto queda en negro.
\lstdefinelanguage{HTMLx}{
  sensitive=true,
  morestring=[b]",
  moredelim=[s][\color{black}]{>}{<},
  morecomment=[s]{<!--}{-->},
  morekeywords=[1]{lang,charset,href,rel,src,type,name,placeholder,value,checked,onclick,onsubmit,id,class,for,action,method},
  morekeywords=[2]{function},
  literate={!-- Salto de línea --}{{\textcolor{htCom}{!-{}- Salto de línea -{}-}}}{19}
           {console.log("escribiendo js directo en el HTML");}{{\textcolor[HTML]{001080}{console}.\textcolor[HTML]{795E26}{log}(\textcolor{htJsStr}{"escribiendo js directo en el HTML"});}}{49}
           {console.log("esto se muestra al presionar submit");}{{\textcolor[HTML]{001080}{console}.\textcolor[HTML]{795E26}{log}(\textcolor{htJsStr}{"esto se muestra al presionar submit"});}}{50}
           {event.preventDefault();}{{event.\textcolor[HTML]{795E26}{preventDefault}();}}{23}
           {function}{{\textcolor{htStr}{function}}}{8}
           {jsEnHTML}{{\textcolor[HTML]{795E26}{jsEnHTML}}}{8}
           {mostrarNombre}{{\textcolor[HTML]{795E26}{mostrarNombre}}}{13}
           {\{}{{\textcolor{htStr}{\{}}}1 {\}}{{\textcolor{htStr}{\}}}}1
           {<!DOCTYPE html>}{{<!DOCTYPE \textcolor{htAttr}{html}>}}{15}
           {page-one.html}{{\smash{\underline{page-one.html}}}}{13}
           {page-two.html}{{\smash{\underline{page-two.html}}}}{13}
           {index.html}{{\smash{\underline{index.html}}}}{10}
           {styles.css}{{\smash{\underline{styles.css}}}}{10}
           {miCodigo.js}{{\smash{\underline{miCodigo.js}}}}{10}
           {otroCodigo.js}{{\smash{\underline{otroCodigo.js}}}}{13}
           {http://server.com/procesar}{{\smash{\underline{http://server.com/procesar}}}}{26},
}
\lstdefinelanguage{CSSx}{
  sensitive=true,
  alsoletter={-\#0123456789},
  morekeywords=[1]{color,margin,padding,width,font-size,font-weight,font-family,padding-left,padding-right,margin-left,margin-right,border},
  morekeywords=[2]{bold,solid,Arial,Helvetica,sans-serif},
  morekeywords=[7]{blue},
  morekeywords=[3]{0,300px,50px,30px,10px,15px},
  morekeywords=[4]{red},
  morekeywords=[5]{black},
  morekeywords=[6]{\#8a8e27},
  literate={\{}{{\textcolor[HTML]{0000FF}{\{}}}1 {\}}{{\textcolor[HTML]{0000FF}{\}}}}1,
}
% Editor claro con etiquetas rojo oscuro (numeros de linea turquesa)
\lstdefinestyle{htmlvs}{language=HTMLx,basicstyle=\color{htTag},
  keywordstyle=[1]\color{htAttr},stringstyle=\color{htStr},commentstyle=\color{htCom},
  numbers=left,numberstyle=\color[HTML]{237893}}
% Ídem sin numeros
\lstdefinestyle{htmlsin}{style=htmlvs,numbers=none}
% Editor con etiquetas negras y numeros grises
\lstdefinestyle{htmlk}{language=HTMLx,basicstyle=\color{black},
  keywordstyle=[1]\color{htAttr},keywordstyle=[2]\color{htStr},
  stringstyle=\color{htStr},commentstyle=\color{htCom},
  moredelim=[s][\color{htJsStr}]{console.log("}{")},
  numbers=left,numberstyle=\color[HTML]{6E7681}}
\lstdefinestyle{css}{language=CSSx,basicstyle=\color{htTag},
  keywordstyle=[1]\color{htAttr},keywordstyle=[2]\color{cssVal},keywordstyle=[3]\color{cssNum},
  keywordstyle=[4]\swR,keywordstyle=[5]\swK,keywordstyle=[6]\swO,keywordstyle=[7]\swB}

% ===== Cajas, lineas y tablas =======================================================
% \utnbox[opciones tikz]{x}{y}{ancho}{alto}{contenido}: caja con texto centrado
\newcommand{\utnbox}[6][]{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=north west,inner sep=3pt,text width=#4\paperwidth-6pt,minimum width=#4\paperwidth,
          minimum height=#5\paperheight,align=center,#1] at
      ($(current page.north west)+(#2\paperwidth,-#3\paperheight)$) {#6};
  \end{tikzpicture}}
% \utnline[opciones]{x1}{y1}{x2}{y2}: linea (o flecha) entre dos puntos
\newcommand{\utnline}[5][]{%
  \begin{tikzpicture}[remember picture,overlay]
    \draw[#1] ($(current page.north west)+(#2\paperwidth,-#3\paperheight)$) --
              ($(current page.north west)+(#4\paperwidth,-#5\paperheight)$);
  \end{tikzpicture}}
