  morekeywords=[1]{var,let,const,function,class,new,async,await},
  morekeywords=[2]{if,else,switch,case,break,continue,default,try,catch,finally,for,while,do,of,return,throw},
  morekeywords=[3]{this,true,false,null,undefined},
  sensitive=true,
  morecomment=[l]{//},
  morestring=[b]",
  morestring=[b]',
  morestring=[b]`,
}

\lstset{language=JS,showstringspaces=false,columns=fixed,keepspaces=true,
  tabsize=2,aboveskip=0pt,belowskip=0pt,xleftmargin=0pt,resetmargins=true,
  upquote=false,extendedchars=true}

