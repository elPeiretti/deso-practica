% Macros y estilos propios de la presentacion de JavaScript:
% resaltado de codigo (listings), diapositivas de seccion con subtitulo amarillo,
% emojis y texto con formato. El tema compartido esta en beamerthemeUTN.sty.
\ProvidesPackage{deck}[2026/10/25 Macros de la presentacion de JavaScript]

\RequirePackage{array}
\RequirePackage{listings}
\RequirePackage[normalem]{ulem}

% --- Colores ----------------------------------------------------------------
\definecolor{utnYellow}{HTML}{F7DF1E}   % amarillo de JavaScript
\definecolor{lstGray}{HTML}{6E7681}

% El texto original ya trae comillas y guiones tipograficos: se usa la familia sin
% ligaduras TeX (\utnplain) como fuente por defecto, para que " ' ` -- y << se
% muestren tal cual (la del tema aplica ligaduras TeX).
\makeatletter
\begingroup\utnplain\xdef\utn@plainfam{\f@family}\endgroup
\renewcommand{\sfdefault}{\utn@plainfam}
\renewcommand{\rmdefault}{\utn@plainfam}
\makeatother

% --- Texto con formato --------------------------------------------------------
\newcommand{\red}[1]{\textcolor{utnRed}{#1}}
\newcommand{\yellow}[1]{\textcolor{utnYellow}{#1}}
\newcommand{\emoji}[1]{\raisebox{-0.12em}{\includegraphics[height=1em]{emoji-#1}}}

% Codigo en linea: DejaVu Sans Mono es mas ancha que Consolas, se reduce un poco
\renewcommand{\code}[1]{{\ttfamily\addfontfeature{Scale=0.83}#1}}
% Sin cortes de palabra (el texto original no los tiene)
\hyphenpenalty=10000 \exhyphenpenalty=10000

% Vinetas un poco mas grandes, como en la plantilla original
\setbeamertemplate{itemize item}{\scalebox{1.3}{$\bullet$}}

% Vinetas de tercer nivel (cuadrado chico, como en la plantilla original)
\setbeamertemplate{itemize subsubitem}{\tiny$\blacksquare$}
\setbeamercolor{itemize subsubitem}{fg=utnText}

% --- Diapositivas de seccion (fondo azul oscuro) ------------------------------
% \utnportadajs{imagen} : portada con titulo en dos lineas
% \utnfondo{contenido}  : diapositiva sin cabecera con fondo azul
\newenvironment{utnfondo}
  {\begingroup\setbeamercolor{background canvas}{bg=utnNavy}\begin{frame}[plain]}
  {\end{frame}\endgroup}

% Titulo grande en Merriweather (ancla en la linea base)
\newcommand{\utntitulo}[4][white]{% [color]{x}{y}{texto}
  \utnnote[anchor=base west,text=#1,font=\utnserif\fontsize{51}{56}\selectfont]{#2}{#3}{#4}}
\newcommand{\utnsubtitulo}[3]{% {x}{y}{texto}
  \utnnote[anchor=west,text=utnYellow,font=\fontsize{15.2}{18}\selectfont]{#1}{#2}{#3}}

% --- Codigo -------------------------------------------------------------------
\lstdefinelanguage{JS}{
  morekeywords=[1]{var,let,const,function,class,new,async,await},
  morekeywords=[2]{if,else,switch,case,break,continue,default,try,catch,finally,for,while,do,of,return,throw},
  morekeywords=[3]{this,true,false,null,undefined},
  sensitive=true,
  morecomment=[l]{//},
  morestring=[b]",
  morestring=[b]',
  morestring=[b]`,
}

\lstset{language=JS,showstringspaces=false,columns=fixed,keepspaces=true,
  tabsize=2,aboveskip=0pt,belowskip=0pt,xleftmargin=0pt,resetmargins=true,
  upquote=false,extendedchars=true}

