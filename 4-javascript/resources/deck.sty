% Captura de Carbon (una sola linea)
\lstdefinestyle{utncarbon}{
  basicstyle=\color[HTML]{E8896A},
  keywordstyle=[1]\color[HTML]{E8896A},
  stringstyle=\color[HTML]{FFD700},
  commentstyle=\color[HTML]{C8C8C8},
  numbers=left,numberstyle=\color[HTML]{8A8A8A}}

% \utncode[claves]{archivo}  -- bloque de codigo posicionado con fracciones de la
% diapositiva (x, y, w, h) y medidas en puntos (letra, interlineado, margenes).
% Claves: style, x, y, w, h, bg (HTML), fs, lh, padx, pady, num (distancia desde el
% borde izquierdo hasta el borde derecho de los numeros de linea), first.
\pgfkeys{/utncode/.cd,
  style/.store in=\ucStyle, x/.store in=\ucX, y/.store in=\ucY,
  w/.store in=\ucW, h/.store in=\ucH, bg/.store in=\ucBg,
  fs/.store in=\ucFS, lh/.store in=\ucLH,
  padx/.store in=\ucPadX, pady/.store in=\ucPadY,
  num/.store in=\ucNum, first/.store in=\ucFirst}
\newcommand{\utncode}[2][]{%
  \begingroup
  \pgfkeys{/utncode/.cd,first=1,num=0,#1}%
  \definecolor{ucbg}{HTML}{\ucBg}%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[ucbg] ($(current page.north west)+(\ucX\paperwidth,-\ucY\paperheight)$)
      rectangle +(\ucW\paperwidth,-\ucH\paperheight);
    \node[anchor=north west,inner sep=0] at
      ($(current page.north west)+(\ucX\paperwidth+\ucPadX pt,-\ucY\paperheight-\ucPadY pt)$) {%
      \begin{minipage}{\dimexpr\ucW\paperwidth-\ucPadX pt\relax}
        \ttfamily\fontsize{\ucFS}{\ucLH}\selectfont
        \lstinputlisting[style=\ucStyle,firstnumber=\ucFirst,
          numbersep=\dimexpr\ucPadX pt-\ucNum pt\relax]{resources/code/#2}%
      \end{minipage}};
  \end{tikzpicture}%
  \endgroup}

% \utnrect{color}{grosor}{x}{y}{w}{h}: rectangulo sin relleno (resaltados, marcos)
\newcommand{\utnrect}[6]{%
  \begin{tikzpicture}[remember picture,overlay]
    \draw[#1,line width=#2pt] ($(current page.north west)+(#3\paperwidth,-#4\paperheight)$)
      rectangle +(#5\paperwidth,-#6\paperheight);
  \end{tikzpicture}}
